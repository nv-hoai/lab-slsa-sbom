              "name": "PythonMatcherExactDirectMatch",
              "shortDescription": {
                "text": "GHSA-9hjg-9r4m-mvj7 medium vulnerability for requests package"
              },
              "fullDescription": {
                "text": "Requests vulnerable to .netrc credentials leak via malicious URLs"
              },
              "helpUri": "https://github.com/advisories/GHSA-9hjg-9r4m-mvj7",
              "help": {
                "text": "Vulnerability GHSA-9hjg-9r4m-mvj7\nSeverity: medium\nPackage: requests\nVersion: 2.32.3\nFix Version: 2.32.4\nType: python\nLocation: /.python-packages/requests-2.32.3.dist-info/METADATA\nData Namespace: github:language:python\nLink: [GHSA-9hjg-9r4m-mvj7](https://github.com/advisories/GHSA-9hjg-9r4m-mvj7)",
                "markdown": "**Vulnerability GHSA-9hjg-9r4m-mvj7**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | requests  | 2.32.3  | 2.32.4  | python  | /.python-packages/requests-2.32.3.dist-info/METADATA  | github:language:python  | [GHSA-9hjg-9r4m-mvj7](https://github.com/advisories/GHSA-9hjg-9r4m-mvj7)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:pypi/requests@2.32.3"
                ],
                "security-severity": "5.3"
              }
            },
